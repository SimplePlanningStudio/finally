# DeepSeek API key for AI chat (https://platform.deepseek.com).
# Optional: without it the app runs, but POST /api/chat returns 503.
DEEP_SEEK_API_KEY=

# Optional: override the LiteLLM model name (default: deepseek/deepseek-flash)
LLM_MODEL=

# Optional: Massive (Polygon.io) API key for real market data; empty = simulator
MASSIVE_API_KEY=

# Optional: Massive poll interval in seconds (default 15 = free tier)
MASSIVE_POLL_SECONDS=15

# Optional: SQLite file path (default: /app/db/finally.db in Docker, <project root>/db/finally.db locally)
DB_PATH=

# Optional: "true" for a scripted fake LLM instead of DeepSeek (E2E tests only)
FAKE_LLM=false
